{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "mcp": {
    "servers": {
      "blender-mcp": {
        "type": "local",
        "command": [
          "/home/saliherdemk/.local/bin/uvx",
          "mcp-for-blender"
        ],
        "environment": {
          "BLENDER_HOST": "localhost",
          "BLENDER_PORT": "9876"
        }
      }
    }
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ]
}
